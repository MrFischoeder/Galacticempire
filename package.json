{
  "name": "galactic-empire",
  "version": "0.1.9a",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @ge/client dev",
    "build": "pnpm --filter @ge/client build",
    "typecheck": "pnpm -r typecheck && tsc -p tests/tsconfig.json && tsc -p tools/tsconfig.json",
    "lint": "eslint .",
    "test": "pnpm -r test && vitest run --dir tests",
    "format": "prettier --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "balance": "tsx tools/balance/report.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
